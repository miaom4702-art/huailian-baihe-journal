# 数据库（SQLite 本地演示；生产建议改为 PostgreSQL）
DATABASE_URL="file:./dev.db"

# 应用信息
APP_NAME="淮联百合学刊"
SESSION_COOKIE="hlbh_session"
SESSION_TTL_HOURS="72"

# 生产环境务必设置 NODE_ENV=production 并启用 HTTPS
NODE_ENV="development"

# 设为 true 时，db:seed 会写入演示文章与投稿
SEED_DEMO_ARTICLES="false"

# 公开联系信息（生产环境在部署平台设置真实值）
CONTACT_EMAIL="editor@example.com"
GROUP_NUMBER="000000000"

# 首个管理员的种子账号（仅供 prisma db seed 使用，部署后请立即修改密码）
SEED_ADMIN_EMAIL="admin@hlbh.org"
SEED_ADMIN_PASSWORD="Admin@HLBH2026"

# 站内 AI 助手（服务端使用，切勿提交真实 Key）
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_MODEL="qwen-plus"
