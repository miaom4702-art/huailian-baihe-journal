# 复制为 .env 后填写真实值；不要把 .env 提交到 Git
DOMAIN=journal.example.com

DATABASE_URL="file:/data/hlbh.db"
SESSION_COOKIE="hlbh_session"
SESSION_TTL_HOURS="72"
NODE_ENV="production"

# 默认不生成演示文章；需要演示数据时设为 true
SEED_DEMO_ARTICLES="false"

# 公开联系信息（在部署环境填写真实值；不要提交到 Git）
CONTACT_EMAIL="editor@example.com"
GROUP_NUMBER="000000000"

# 仅首次执行 npm run db:seed 时使用
SEED_ADMIN_PASSWORD="请替换为至少12位的强密码"
